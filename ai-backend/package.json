{
  "name": "excalidraw-ai-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:studio": "node scripts/run-prisma-with-aifaboard-env.mjs studio --schema prisma/schema.prisma",
    "prisma:push": "node scripts/run-prisma-with-aifaboard-env.mjs db push --schema prisma/schema.prisma",
    "db:copy-to": "node scripts/copy-postgres-tables.mjs",
    "db:snapshot:export": "node scripts/db-snapshot.mjs export",
    "db:snapshot:seed": "node scripts/db-snapshot.mjs seed",
    "db:table-sizes": "node scripts/db-table-sizes.mjs",
    "mcp:search-images": "node mcp/search-images-server.mjs",
    "mcp:fetch-images": "node mcp/fetch-images-server.mjs"
  },
  "dependencies": {
    "@clerk/backend": "3.2.4",
    "@clerk/express": "2.0.8",
    "@modelcontextprotocol/sdk": "1.12.1",
    "@prisma/client": "6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "8.3.2",
    "helmet": "8.1.0",
    "openai": "^4.77.0",
    "pg": "8.20.0",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "prisma": "6.19.3",
    "prom-client": "15.1.3",
    "socket.io": "4.8.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "pino-pretty": "13.1.3"
  }
}
