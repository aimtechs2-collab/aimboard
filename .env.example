# Copy to `.env.development.local` (repo root) and fill in. Do not commit real values.

# --- Frontend (Vite; prefix VITE_) ---
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_or_pk_live_...   (browser-safe; from Clerk API keys)
#
# Server only — never prefix with VITE_ (would leak into the client bundle):
# CLERK_SECRET_KEY=sk_test_or_sk_live_...
# VITE_APP_AI_BACKEND=https://your-api.example.com
# Live collaboration (Socket.IO on the same Node server as ai-backend):
# VITE_APP_WS_SERVER_URL=https://your-api.example.com
# If omitted, the app falls back to the origin of VITE_APP_AI_BACKEND.
# VITE_APP_PORT=3001
#
# Dashboard + saved boards (`/dashboard`, `/board/:id`) call the same API as AI features.
# Set CORS_ORIGINS to include your app origin (e.g. http://localhost:3000 for Vite dev).

# --- AI backend (Node reads these from repo root or Render/Fly env) ---
# Logging: LOG_LEVEL=debug|info|warn|error  (default debug in dev, info in production)
# Human-readable HTTP logs in dev: LOG_PRETTY=1 (default on when NODE_ENV is not production; needs pino-pretty)
# JSON logs only (e.g. production / Docker): LOG_PRETTY=0
# NODE_ENV=production
# On Render/Heroku, PORT is set automatically — the server uses PORT first, then:
# AI_BACKEND_PORT=3016
# AI_BACKEND_HOST=0.0.0.0
# TRUST_PROXY=1
# CORS_ORIGINS=https://your-app.example.com,https://www.your-app.example.com
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# Optional: model for sidebar image-search query expansion (defaults to OPENAI_MODEL)
# OPENAI_IMAGE_QUERY_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
# AI provider routing (sidebar + text-to-diagram):
# AI_PROVIDER_DEFAULT=openai   # openai | ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL_DEFAULT=llama3.1:8b
# OLLAMA_TIMEOUT_MS=120000
# CLERK_SECRET_KEY=sk_live_or_test_...
# NEON_DATABASE_URL=postgresql://...
# Upstash Redis (optional cache layer to reduce DB reads / network transfer):
# UPSTASH_REDIS_REST_URL=https://<region>-<name>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# Cache key prefix + conservative limits (good defaults for free tier):
# REDIS_CACHE_PREFIX=aifaboard:v1
# REDIS_CACHE_MAX_ENTRY_BYTES=65536
# REDIS_CACHE_TTL_FOLDERS_LIST_SECONDS=25
# REDIS_CACHE_TTL_BOARDS_LIST_SECONDS=20
#
# Sidebar AI reference images (fetch_images):
# SerpAPI Google Images (https://serpapi.com/) — required.
# SERPAPI_API_KEY=...
# Optional override: SERPAPI_ENDPOINT=https://serpapi.com/search.json
#
# Optional: max gzip-compressed scene size per board save (bytes)
# BOARD_SCENE_MAX_GZIP_BYTES=12582912
